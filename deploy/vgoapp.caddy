# vgoapp.com — owned by the VGOAPP repo.
# Installed to /etc/caddy/sites/vgoapp.caddy by scripts/deploy.sh; the shared
# /etc/caddy/Caddyfile imports every *.caddy in that directory. Keep MDDock's
# sites out of this file.
#
# The shared entrypoint (/etc/caddy/Caddyfile), the sites directory, UFW,
# Docker and SSH hardening are owned by the platform repo `vps-infra`
# (https://github.com/edwin-hao-ai/vps-infra). Do not write them from here:
# an MDDock deploy applies vps-infra on every run, so anything written outside
# `sites/vgoapp.caddy` is either overwritten or silently drifts.
#
# 语法坑（2026-11-16 实测）：
#   `redir` 在只有两个参数时，第一个一定是**匹配器**、第二个才是目标。
#   所以 `redir / permanent` = 匹配 `/`、目标 `permanent` → 跳到 /zh/permanent。
#   要无条件跳转就写三个参数：`redir * <目标> permanent`。
#   另外 `handle` / `handle_path` 是终结性的：内层没有指令命中时它不回落到
#   兄弟 handle，而是直接返回一个空的 200（/macslim/ 当时就是这样「200 空白」）。

# 共享 Caddyfile 全局设了 `auto_https disable_redirects`，所以 80 端口不会
# 自动跳 443。要恢复 https，只能自己显式声明 http:// 站点。
# 之前写 `http://vgoapp.com, https://vgoapp.com { … }` 等于让明文端口直接发页面，
# 同一内容两个协议版本（Search Console 里 10 条「备用网页」含 http://vgoapp.com/）。
http://vgoapp.com {
  redir * https://vgoapp.com{uri} permanent
}

vgoapp.com {
  encode zstd gzip

  # --- 旧站结构：Search Console 到 2026-11 还在抓的 404 ----------------------
  # /zh/ 曾经是中文首页（现在的不带前缀 `/` 就是中文）。
  redir /zh / permanent
  redir /zh/* / permanent
  # 旧站的两个独立页面，内容已经不存在。
  redir /download.html /remotecrab/ permanent
  redir /join.html / permanent

  # --- MacSlim → SlimDisk 改名（2026-10-16，当时没留跳转）-------------------
  # handle_path 会剥掉 /macslim 前缀，所以内层用剩下的 path 拼目标，一跳直达。
  # 裸路径 `/macslim` 不匹配 `/macslim/*`，各补一条。
  handle_path /macslim/* {
    redir * /slimdisk{http.request.uri.path} permanent
  }
  redir /macslim /slimdisk/ permanent
  handle_path /en/macslim/* {
    redir * /en/slimdisk{http.request.uri.path} permanent
  }
  redir /en/macslim /en/slimdisk/ permanent

  # RemoteCrab rendezvous service (separate systemd unit, loopback on the
  # docker bridge).
  handle_path /remotecrab/rendezvous/* {
    reverse_proxy 172.18.0.1:8787
  }

  # RemoteCrab 链接共享的信令（2026-11-18）。只做"门牌号与转发"，媒体走 P2P。
  # 信令进程只绑 docker 桥关（172.18.0.1:8799），所以只有这个容器能连它；
  # 公网是打不进来的（ufw 只放行 172.18.0.0/16）。
  handle_path /remotecrab/r/signal* {
    reverse_proxy 172.18.0.1:8799
  }

  # 短链（2026-11-21）：/l/<6 位码> → 观看页。宣传物料里出现的地址必须真的能打开。
  handle /l/* {
    @six path_regexp six ^/l/([0-9]{6})$
    redir @six https://vgoapp.com/remotecrab/r/?code={re.six.1} temporary
    redir https://vgoapp.com/remotecrab/r/ temporary
  }

  # 观看页必须每次回源（2026-11-20）：它是产品的一部分，改一次用户就得看见一次。
  # Safari 会长期沿用旧 HTML，「我是不是还在用老版本」就是这么来的。
  handle /remotecrab/r/* {
    header Cache-Control "no-cache, must-revalidate"
    root * /var/www/vgoapp
    file_server
  }

  handle {
    root * /var/www/vgoapp
    file_server
  }
}
